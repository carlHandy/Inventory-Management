<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryManager.Views.LowStockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:InventoryManager.Models"
    xmlns:vm="clr-namespace:InventoryManager.ViewModels"
    x:DataType="vm:LowStockViewModel"
    Title="Low Stock">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Summary}" Style="{StaticResource TitleLabel}" TextColor="{StaticResource Warning}" />
            <Label Text="{Binding ThresholdText}" Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedProduct}">
            <CollectionView.EmptyView>
                <Label Text="Nothing to restock right now."
                       Style="{StaticResource MutedLabel}"
                       HorizontalTextAlignment="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Row="0" Text="{Binding Name}" Style="{StaticResource TitleLabel}" />
                            <Label Grid.Row="1" Text="{Binding Category}" Style="{StaticResource MutedLabel}" />
                            <VerticalStackLayout Grid.RowSpan="2" Grid.Column="1" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                       Style="{StaticResource TitleLabel}"
                                       TextColor="{StaticResource Danger}"
                                       HorizontalTextAlignment="End" />
                                <Border Style="{StaticResource WarningBadge}" HorizontalOptions="End">
                                    <Label Text="{Binding StockStatus}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Warning}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
