<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryManager.Views.LowStockPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InventoryManager.Controls"
    xmlns:models="clr-namespace:InventoryManager.Models"
    xmlns:vm="clr-namespace:InventoryManager.ViewModels"
    x:DataType="vm:LowStockViewModel"
    Title="Low Stock">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="16,16,16,8">

            <!-- Summary -->
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Summary}" Style="{StaticResource HeadingLabel}" />
                <Label Text="{Binding ThresholdText}" Style="{StaticResource MutedLabel}" />
            </VerticalStackLayout>

            <!-- KPI tiles -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OUT OF STOCK" Style="{StaticResource MetricCaption}" />
                        <Label Text="{Binding OutOfStockCount}"
                               Style="{StaticResource MetricValue}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="RUNNING LOW" Style="{StaticResource MetricCaption}" />
                        <Label Text="{Binding RunningLowCount}"
                               Style="{StaticResource MetricValue}"
                               TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="RESTOCK QUEUE" Style="{StaticResource SectionHeader}" Margin="0,4,0,0" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedProduct}"
                        Margin="16,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="6" Padding="24,48" HorizontalOptions="Center">
                    <Label Text="Nothing to restock" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
                    <Label Text="Every product is above the low-stock threshold."
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <controls:ProductRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
