<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryManager.Views.ProductEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:InventoryManager.ViewModels"
    x:DataType="vm:ProductEditViewModel"
    Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <!-- Red asterisk after required field captions -->
        <Style x:Key="RequiredMark" TargetType="Span">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- ===== General ===== -->
                <Label Text="GENERAL" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">

                        <Label Style="{StaticResource FieldLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Product name " />
                                    <Span Text="*" Style="{StaticResource RequiredMark}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource InputField}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasNameError}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding Name}" Placeholder="e.g. USB-C cable" MaxLength="100" />
                        </Border>
                        <Label Text="{Binding NameError}" IsVisible="{Binding HasNameError}" Style="{StaticResource ErrorLabel}" />

                        <Label Style="{StaticResource FieldLabel}" Margin="0,8,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Category " />
                                    <Span Text="*" Style="{StaticResource RequiredMark}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource InputField}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasCategoryError}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <!-- Picker spans the full width so the whole box is tappable;
                                 the chevron is drawn on top and lets taps pass through. -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Picker Grid.ColumnSpan="2"
                                        Title="Select a category"
                                        ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding Category}" />
                                <Path Grid.Column="1"
                                      Data="M0,0 L6,6 L12,0"
                                      Stroke="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                      StrokeThickness="2"
                                      StrokeLineCap="Round"
                                      StrokeLineJoin="Round"
                                      WidthRequest="14"
                                      HeightRequest="8"
                                      Margin="0,0,4,0"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding CategoryError}" IsVisible="{Binding HasCategoryError}" Style="{StaticResource ErrorLabel}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Pricing & inventory ===== -->
                <Label Text="PRICING &amp; INVENTORY" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

                        <Label Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Unit price " />
                                    <Span Text="*" Style="{StaticResource RequiredMark}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InputField}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasPriceError}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding PriceText}" Placeholder="0.00" Keyboard="Numeric" />
                        </Border>
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding PriceError}" IsVisible="{Binding HasPriceError}" Style="{StaticResource ErrorLabel}" />

                        <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldLabel}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Quantity " />
                                    <Span Text="*" Style="{StaticResource RequiredMark}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InputField}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasQuantityError}" Value="True">
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Entry Text="{Binding QuantityText}" Placeholder="0" Keyboard="Numeric" />
                        </Border>
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding QuantityError}" IsVisible="{Binding HasQuantityError}" Style="{StaticResource ErrorLabel}" />
                    </Grid>
                </Border>

                <Label Text="Fields marked * are required." Style="{StaticResource MutedLabel}" FontSize="12" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned actions -->
        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
