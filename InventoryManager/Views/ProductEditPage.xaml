<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryManager.Views.ProductEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:InventoryManager.ViewModels"
    x:DataType="vm:ProductEditViewModel"
    Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <Label Text="Name *" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Name}" Placeholder="e.g. USB-C cable" MaxLength="100" />
            <Label Text="{Binding NameError}" IsVisible="{Binding HasNameError}" Style="{StaticResource ErrorLabel}" />

            <Label Text="Category *" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <Picker Title="Select a category"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding Category}" />
            <Label Text="{Binding CategoryError}" IsVisible="{Binding HasCategoryError}" Style="{StaticResource ErrorLabel}" />

            <Label Text="Price *" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <Entry Text="{Binding PriceText}" Placeholder="e.g. 12.50" Keyboard="Numeric" />
            <Label Text="{Binding PriceError}" IsVisible="{Binding HasPriceError}" Style="{StaticResource ErrorLabel}" />

            <Label Text="Quantity *" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
            <Entry Text="{Binding QuantityText}" Placeholder="e.g. 25" Keyboard="Numeric" />
            <Label Text="{Binding QuantityError}" IsVisible="{Binding HasQuantityError}" Style="{StaticResource ErrorLabel}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20,0,0">
                <Button Grid.Column="0" Text="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsNotBusy}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
