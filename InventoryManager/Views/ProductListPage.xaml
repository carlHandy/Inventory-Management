<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryManager.Views.ProductListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InventoryManager.Controls"
    xmlns:models="clr-namespace:InventoryManager.Models"
    xmlns:vm="clr-namespace:InventoryManager.ViewModels"
    x:DataType="vm:ProductListViewModel"
    Title="Products">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add" IconImageSource="icon_add.png" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <!-- Fixed header: KPIs, low-stock alert, search and filter -->
        <VerticalStackLayout Grid.Row="0" Spacing="12" Padding="16,16,16,8">

            <!-- KPI tiles (whole inventory) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PRODUCTS" Style="{StaticResource MetricCaption}" />
                        <Label Text="{Binding TotalProducts}" Style="{StaticResource MetricValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="UNITS" Style="{StaticResource MetricCaption}" />
                        <Label Text="{Binding TotalUnitsDisplay}" Style="{StaticResource MetricValue}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="VALUE" Style="{StaticResource MetricCaption}" />
                        <Label Text="{Binding InventoryValueDisplay}" Style="{StaticResource MetricValue}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Low-stock alert (only when there are low-stock products); tap to open the Low Stock tab -->
            <Border Style="{StaticResource WarningAlert}" IsVisible="{Binding HasLowStock}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewLowStockCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Image Grid.Column="0" Source="icon_alert.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding LowStockBanner}"
                           FontFamily="{StaticResource FontMedium}"
                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="2"
                           Text="Review ›"
                           FontSize="13"
                           FontFamily="{StaticResource FontMedium}"
                           TextColor="{AppThemeBinding Light={StaticResource Warning}, Dark={StaticResource WarningDark}}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Search -->
            <Border Style="{StaticResource InputField}" Padding="0" MinimumHeightRequest="44">
                <SearchBar Placeholder="Search by name or category" Text="{Binding SearchText}" />
            </Border>

            <!-- Result count + "only in stock" filter -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <Label Grid.Column="0" Text="{Binding ResultsText}" Style="{StaticResource SectionHeader}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Only in stock" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                <Switch Grid.Column="2" IsToggled="{Binding InStockOnly}" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedProduct}"
                        Margin="16,0">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="6" Padding="24,48" HorizontalOptions="Center">
                    <Label Text="No products found" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
                    <Label Text="Try a different search, or tap Add to register a product."
                           Style="{StaticResource MutedLabel}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <controls:ProductRow />
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="8" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
