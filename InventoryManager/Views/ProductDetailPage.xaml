<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryManager.Views.ProductDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InventoryManager.Controls"
    xmlns:vm="clr-namespace:InventoryManager.ViewModels"
    x:DataType="vm:ProductDetailViewModel"
    Title="Product Details">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Header: avatar, name, category, status -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Style="{StaticResource AvatarTile}" WidthRequest="52" HeightRequest="52" VerticalOptions="Start">
                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarText}" FontSize="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding Name}" Style="{StaticResource HeadingLabel}" />
                            <Label Text="{Binding Category}" Style="{StaticResource MutedLabel}" />
                            <controls:StatusPill Level="{Binding StockLevel}" Text="{Binding StockStatus}" Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Key figures -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="ON HAND" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding QuantityDisplay}" Style="{StaticResource MetricValue}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="UNIT PRICE" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding PriceDisplay}" Style="{StaticResource MetricValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="STOCK VALUE" Style="{StaticResource MetricCaption}" />
                            <Label Text="{Binding TotalValueDisplay}" Style="{StaticResource MetricValue}" FontSize="16" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Quick stock adjustment -->
                <Label Text="STOCK ADJUSTMENT" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button Grid.Column="0" Text="−"
                                    Style="{StaticResource StepperButton}"
                                    Command="{Binding AdjustStockCommand}"
                                    CommandParameter="-1" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding QuantityDisplay}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="units on hand" Style="{StaticResource MutedLabel}" FontSize="12" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="+"
                                    Style="{StaticResource StepperButton}"
                                    Command="{Binding AdjustStockCommand}"
                                    CommandParameter="1" />
                        </Grid>
                        <Label Text="{Binding StatusMessage}"
                               IsVisible="{Binding HasStatusMessage}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Record information -->
                <Label Text="RECORD" Style="{StaticResource SectionHeader}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}" Padding="16,4">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Label Text="Product ID" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Column="1" Text="{Binding IdDisplay}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Label Text="Category" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Column="1" Text="{Binding Category}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Label Text="Status" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Column="1" Text="{Binding StockStatus}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Label Text="Created" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Column="1" Text="{Binding CreatedText}" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="0,12">
                            <Label Text="Last updated" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Column="1" Text="{Binding UpdatedText}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Pinned actions -->
        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                <Button Grid.Column="1" Text="Edit product" Command="{Binding EditCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
