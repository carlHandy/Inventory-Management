<?xml version="1.0" encoding="utf-8" ?>
<!-- One product row, shared by the Products and Low Stock lists. BindingContext is a Product. -->
<ContentView
    x:Class="InventoryManager.Controls.ProductRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:InventoryManager.Controls"
    xmlns:models="clr-namespace:InventoryManager.Models"
    x:DataType="models:Product"
    Padding="0,0,0,8">

    <!-- Keep the row transparent when tapped; the card itself is the visual -->
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroupList>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="Transparent" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateGroupList>
    </VisualStateManager.VisualStateGroups>

    <Border Style="{StaticResource Card}" Padding="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

            <Border Grid.Column="0" Style="{StaticResource AvatarTile}">
                <Label Text="{Binding Initials}" Style="{StaticResource AvatarText}" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="{Binding Name}" Style="{StaticResource TitleLabel}" LineBreakMode="TailTruncation" />
                <Label Style="{StaticResource MutedLabel}" LineBreakMode="TailTruncation">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Category}" />
                            <Span Text="  ·  " />
                            <Span Text="{Binding PriceDisplay}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                <Label HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Quantity, StringFormat='{0:N0}'}" FontSize="16" FontAttributes="Bold" />
                            <Span Text=" units" FontSize="12"
                                  TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <controls:StatusPill Level="{Binding StockLevel}" Text="{Binding StockStatus}" HorizontalOptions="End" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
