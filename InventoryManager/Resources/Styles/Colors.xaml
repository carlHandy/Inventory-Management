<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand colours -->
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#8E75F0</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <!-- Status colours -->
    <Color x:Key="Danger">#C62828</Color>
    <Color x:Key="DangerSoft">#FDECEA</Color>
    <Color x:Key="Warning">#E65100</Color>
    <Color x:Key="WarningSoft">#FFF3E0</Color>
    <Color x:Key="Success">#2E7D32</Color>

    <!-- Light / dark surfaces and text -->
    <Color x:Key="PageLight">#F6F5FA</Color>
    <Color x:Key="PageDark">#121212</Color>
    <Color x:Key="CardLight">#FFFFFF</Color>
    <Color x:Key="CardDark">#1E1E1E</Color>
    <Color x:Key="TextLight">#1B1B1F</Color>
    <Color x:Key="TextDark">#F2F2F2</Color>
    <Color x:Key="MutedLight">#6B6B76</Color>
    <Color x:Key="MutedDark">#A8A8B3</Color>
    <Color x:Key="BorderLight">#D9D8E0</Color>
    <Color x:Key="BorderDark">#3A3A44</Color>
</ResourceDictionary>
